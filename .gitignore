# Composer dependencies (ไม่ต้องอัปโหลดขึ้น GitHub ให้ใช้ composer install บนเซิร์ฟเวอร์แทน)
/vendor/

# Environment and Local Config files (ข้อมูลลับ, ค่าเชื่อมต่อ Database, Cookie Validation Key)
/.env
/common/config/main-local.php
/common/config/params-local.php
/backend/config/main-local.php
/backend/config/params-local.php
/frontend/config/main-local.php
/frontend/config/params-local.php
/console/config/main-local.php
/console/config/params-local.php

# Runtime / Logs / Cache (ไฟล์แคชและประวัติการทำงานของระบบ)
/backend/runtime/*
!/backend/runtime/.gitignore
/frontend/runtime/*
!/frontend/runtime/.gitignore
/console/runtime/*
!/console/runtime/.gitignore

# Web assets (ไฟล์แคชส่วน frontend/backend web assets)
/backend/web/assets/*
!/backend/web/assets/.gitignore
/frontend/web/assets/*
!/frontend/web/assets/.gitignore

# Uploads / Downloads folders (โฟลเดอร์เก็บไฟล์ที่ผู้ใช้อัปโหลด หรือไฟล์ดาวน์โหลดเฉพาะของเซิร์ฟเวอร์)
/downloads/*
!/downloads/.gitignore
/frontend/web/uploads/*
!/frontend/web/uploads/.gitignore

# IDE / Editor specific files
.vscode/
.idea/
.nbproject/
*.suo
*.imi
*.DS_Store

# files generated by the other tools or operating system
.claude/
.htaccess
.mcp.json
404.html
502.html
CLAUDE.md
index.html
